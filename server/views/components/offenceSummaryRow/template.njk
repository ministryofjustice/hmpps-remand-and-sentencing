<div class="offences-summary-card-row">
    <dt class="offences-summary-card-key govuk-!-font-weight-bold">
        {{ offence.offenceCode + ' ' + offenceNameMap[offence.offenceCode] }}
    </dt>
    <dd class="offences-summary-card-value govuk-body-s">{{offence | offenceDatesText }}</dd>
    {% if countNumberBySentenceUuid %}
        {% set countDescription = offence.sentence.countNumber | formatCountNumber(offence.sentence.legacyData.nomisLineReference) %}
        <dd class="offences-summary-card-value govuk-body-s">
            {% if countDescription %}{{ countDescription }}<br>{% endif %}
            {% if offence.sentence.consecutiveToSentenceUuid %}
                Consecutive to {{ countNumberBySentenceUuid[offence.sentence.consecutiveToSentenceUuid] | formatCountNumber }}
            {% elif offence.sentence.sentenceServeType === 'FORTHWITH' %}
                Forthwith
            {% else %}
                Concurrent
            {% endif %}
        </dd>
    {% endif %}
</div>
