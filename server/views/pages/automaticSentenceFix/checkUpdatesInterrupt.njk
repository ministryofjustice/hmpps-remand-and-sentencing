{% extends "../../partials/prisonerBannerLayout.njk" %}
{% from "moj/components/interruption-card/macro.njk" import interruptionCard %}
{% from "hmpps/components/court-cases-release-dates/things-to-do/macro.njk" import thingsToDo %}

{% set pageTitle = applicationName + " - check the automatic updates are correct" %}

{% block content %}
    <div class="govuk-grid-row govuk-!-margin-top-4">
        <div class="govuk-grid-column-full">
            {% call interruptionCard({
                heading: "Check the automatic updates are correct",
                primaryAction: {
                    text: "Continue",
                    href: continueLink,
                    attributes: {
                        "data-qa": "continue-button"
                    }
                }
            }) %}
                <p class="govuk-body">
                    Multiple offences were attached to a single sentence on NOMIS. This service has automatically split these in to individual sentences for each offence. The sentences that have been affected are:
                </p>
                <ul class="govuk-list govuk-list--bullet" data-qa="sentenceList">
                    {% for sentence in sentences %}
                        <li>{{sentence.offenceCode}} {{ offenceMap[sentence.offenceCode] }}<br>
                            {{sentence.sentenceServeType | capitalize }}
                        </li>
                    {% endfor %}
                </ul>
                <p class="govuk-body govuk-!-font-weight-bold">What you need to do</p>
                <p class="govuk-body">Check that the automatic updates to the sentences reflect the warrant on:</p>
                <ul class="govuk-list govuk-list--bullet" data-qa="courtCaseList">
                    {% for courtCase in unconfirmedCourtCases %}
                        <li>
                            Case{{' ' + courtCase.caseReference if courtCase.caseReference }} at {{ courtMap[courtCase.courtCode] }} on {{ courtCase.sentencingHearingDate | formatDate }}
                        </li>
                    {% endfor%}
                </ul>
                <p class="govuk-body">If it does not reflect the warrant, edit the sentence details and try again.</p>
            {% endcall %}
        </div>
    </div>
{% endblock %}
