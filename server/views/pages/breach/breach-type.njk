{% extends "../../partials/backLinkLayout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "components/cancelHearingButton/macro.njk" import cancelToConfirm %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}


{% set pageTitle = applicationName + " - What type of breach are you recording" %}

{% block content %}
    {{ super() }}
        <form method="post" autocomplete="off">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            {{ govukRadios({
                name: "breachType",
                fieldset: {
                    legend: {
                        text: "What type of breach are you recording?",
                        isPageHeading: true,
                        classes: "govuk-fieldset__legend--l"
                    }
                },
                items: [
                    {
                        value: "BREACH_OF_SUPERVISION_REQUIREMENTS",
                        text: "A breach of supervision requirements",
                        hint: {
                            text: "Schedule 12, paragraph 2&3 of Sentencing Act 2020. Previously section 104."
                        }
                    },
                    {
                        value: "BREACH_OF_IMPRISONABLE_OFFENCE",
                        text: "A breach due to imprisonable offence",
                        hint: {
                            text: "Schedule 12 paragraph 7 of Sentencing Act 2020. Previously section 105."
                        }
                    }
                ]
            }) }}

            <div class="govuk-button-group">
                {{ govukButton({
                    text: "Continue",
                    attributes: {  'data-qa': 'continue-button' }
                }) }}

                {{ cancelToConfirm(nomsId, addOrEditCourtCase, courtCaseReference, addOrEditCourtAppearance, appearanceReference, currentPageUrl) }}
            </div>
        </form>

{% endblock %}
