{% extends "../../partials/backLinkLayout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% set pageTitle = applicationName + " - Warrant received" %}

{% block content %}
    {% if errors | length %}
        <div class="govuk-grid-row govuk-!-margin-top-4">
            {{ govukErrorSummary({
                titleText: "There is a problem",
                errorList: errors
            }) }}
        </div>
    {% endif %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                Review new documents and add a court case
            </h1>

            <p class="govuk-body" data-qa="common-platform-text">A new {{warrantTypeText}} warrant for <strong>{{appearance.courtCaseReference}}</strong> has been added from Common Platform.</p>
            <p class="govuk-body">Some information has been added for you.</p>
            <h3 class="govuk-heading-s">The following documents have been added:</h3>

            <div class="govuk-!-padding-bottom-3">
                {% set tableRows = [] %}
                {% for document in appearance.documents %}
                    {% set documentHtml %}
                        <a class="govuk-link govuk-link--no-visited-state prisoner-doc-link"
                            target="_blank"
                            rel="noreferrer noopener"
                            href="/api/document/{{document.documentUUID}}/view-document/{{ (document.fileName) | urlencode }}">
                            {{ document.fileName }}
                            <span class="govuk-visually-hidden">(opens in new tab)</span>
                        </a>
                        <p class="govuk-body">{{document.documentTypeDescription}}</p>
                    {% endset %}
                    {% set tableRows = tableRows.concat([
                        [ {
                            html: documentHtml
                        },
                        {
                            text: appearance.appearanceDate | formatDate
                        },
                        {
                            text: hearing.hearingType
                        }]]) %}
                {% endfor %}
                {{
                    govukTable({
                        head: [
                            {
                                text: "Document"
                            },
                            {
                                text: "Hearing date"
                            },
                            {
                                text: "Hearing type"
                            }
                        ],
                        rows: tableRows
                    })
                }}
            </div>

            <form method="post" autocomplete="off">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                {% if existingCase %}
                    <p class="govuk-body">Before continuing, we need to know how information from this remand warrant should be added.</p>
                    {{ govukRadios({
                        name: "addToExistingCase",
                        fieldset: {
                            legend: {
                                text: 'How you want to add this remand warrant?',
                                classes: "govuk-fieldset__legend--m"
                            }
                        },
                        errorMessage:  errors | findError('addToExistingCase'),
                        items: [
                            {
                                value: "true",
                                text: "Add a new hearing to an existing court case"
                            },
                            {
                                value: "false",
                                text: "Add a new court case"
                            }
                        ]
                    }) }}  
                {% else %}
                    <h3 class="govuk-heading-s">What you need to do</h3>
                    <p class="govuk-body">Review the documents then continue to enter information exactly as it is written on the warrant.</p>
                {% endif %}

                <div class="govuk-button-group">
                    {{ govukButton({
                        text: "Continue",
                        attributes: { "data-qa": "continue-button" }
                    }) }}
                    {{ govukButton({
                        text: "Cancel",
                        classes: "govuk-button--secondary",
                        attributes: { 'data-qa': 'cancel-button' },
                        href: "/person/" + nomsId
                    }) }}
                </div>
            </form>

        </div>
    </div>
{% endblock %}
