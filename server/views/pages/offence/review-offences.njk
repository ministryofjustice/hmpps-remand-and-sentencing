{% extends "../../partials/hearingDetailsLayout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "hmpps/components/court-cases-release-dates/offence-card/macro.njk" import offenceCard %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "components/cancelHearingButton/macro.njk" import cancelToConfirm %}

{% set pageTitle = applicationName + " - Review offences" %}
{% set hideOffences = true %}
{% block pageContent %}
            <h1 class="govuk-heading-l">Review offences</h1>

            {% if mergedFromText %}
                {{ govukInsetText({
                    text: mergedFromText,
                    classes: "govuk-!-margin-bottom-3",
                    attributes: {
                        "data-qa": "mergedFromText"
                    }
                }) }}
            {% endif %}

            {{ govukButton({
                text: "Add an offence" ,
                classes: "govuk-button--link",
                href: "/person/" + nomsId + "/" + addOrEditCourtCase + "/" + courtCaseReference  + "/" + addOrEditCourtAppearance + "/" + appearanceReference + "/offences/" + courtAppearance.offences | length + "/add-another-offence",
                attributes: {
                    "data-qa": "addAnotherOffence"
                }
            }) }}

            {% for offence in unchangedOffences %}
                {% set offenceId = 'offences.' + offence.index %}
                {{
                    offenceCard(offence | offenceToOffenceCard(offenceId, offenceMap, outcomeMap, {}, sentenceTypeMap, courtMap, errors, {
                        actions: {
                            items: [
                                {
                                    href: "/person/" + nomsId + "/" + addOrEditCourtCase + "/" + courtCaseReference  + "/" + addOrEditCourtAppearance + "/" + appearanceReference + "/offences/" + offence.chargeUuid + "/load-edit-offence",
                                    text: "Edit",
                                    visuallyHiddenText: "edit offence"
                                }
                            ]
                        },
                        listItems: {
                            classes: "govuk-!-margin-top-4 govuk-!-margin-bottom-2",
                            items: [{
                                html: '<a href="/person/'+ nomsId + '/' + addOrEditCourtCase + '/' + courtCaseReference  + '/' + addOrEditCourtAppearance + '/' + appearanceReference + '/offences/' + offence.chargeUuid + '/load-update-outcome?backTo=reviewOffences&bulkOffenceTobeUpdated=' + bulkOffenceTobeUpdated + '" data-qa="update-outcome-link-'+ offence.chargeUuid +'" class="govuk-link govuk-link--no-visited-state">Update outcome</a>'
                            }]
                        }
                    }))
                }}
            {% endfor %}

            <h2 class="govuk-heading-m govuk-!-margin-top-8">Offences with updated outcomes</h2>

            {% for offence in changedOffences %}
                {% set multipleCountLinkHtml %}
                    <a href="/person/{{ nomsId }}/{{ addOrEditCourtCase }}/{{ courtCaseReference }}/{{ addOrEditCourtAppearance }}/{{appearanceReference }}/offences/{{offence.chargeUuid }}/load-replicate-offence" data-qa="add-multiple-count-link-{{offence.chargeUuid}}">Add multiple counts</a>
                {% endset %}
                {% set offenceId = 'offences.' + offence.index %}
                {{
                    offenceCard(offence | offenceToOffenceCard(offenceId, offenceMap, outcomeMap, {}, sentenceTypeMap, courtMap, errors, {
                        outcomeUpdated: offence.updatedOutcome,
                        actions: {
                            items: [
                                {
                                    href: "/person/" + nomsId + "/" + addOrEditCourtCase + "/" + courtCaseReference  + "/" + addOrEditCourtAppearance + "/" + appearanceReference + "/offences/" + offence.chargeUuid + "/load-edit-offence",
                                    text: "Edit",
                                    visuallyHiddenText: "edit offence"
                                }
                            ]
                        },
                        listItems: {
                            classes: 'govuk-!-margin-top-4 govuk-!-margin-bottom-2',
                            items: [{
                                html: multipleCountLinkHtml
                            }]
                        }
                    }))
                }}
            {% else %}
                {{ govukInsetText({
                    text: "There are no offences with updated outcomes."
                }) }}
            {% endfor %}


            <form method="post" autocomplete="off">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">

                {{ govukRadios({
                        name: "changeOffence",
                        fieldset: {
                            legend: {
                            text: "Have you finished reviewing offences?",
                            isPageHeading: false,
                            classes: "govuk-fieldset__legend--m"
                            }
                        },
                        errorMessage: errors | findError("changeOffence"),
                        items: [
                            {
                                value: "true",
                                text: "Yes, I've finished reviewing offences"
                            },
                            {
                                value: "false",
                                text: "No, I'll come back to it later"
                            }
                        ]
                    }) }}

                    <div class="govuk-button-group">
                                {{ govukButton({
                                    text: "Continue",
                                    attributes: {  'data-qa': 'continue-button' }
                                }) }}
                                {{ cancelToConfirm(nomsId, addOrEditCourtCase, courtCaseReference, addOrEditCourtAppearance, appearanceReference, currentPageUrl) }}
                    </div>
            </form>

{% endblock %}
