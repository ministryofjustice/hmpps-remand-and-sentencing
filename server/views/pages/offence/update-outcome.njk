{% extends "../../partials/hearingDetailsLayout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "components/cancelHearingButton/macro.njk" import cancelToConfirm %}

{% set pageTitle = applicationName + " - Update offence outcome" %}

{% set fieldSetHtml %}
    <h1 class="govuk-fieldset__heading">
        <span class="govuk-caption-l">Update offence outcomes</span>
        {% if isMultipleOffences %}
            What is the new outcome for these offences?
        {% else %}
            What is the new outcome for this offence?
        {% endif %}
    </h1>
{% endset %}

{% set radiosData = {
        name: "offenceOutcome",
        fieldset: {
            legend: {
            html: fieldSetHtml,
            classes: "govuk-fieldset__legend--l"
            }
        },
        hint: offenceHint if not isMultipleOffences,
        items: []
    } %}

{% for caseOutcome in primaryOutcomes %}
    {% set caseOutcomeRow = {
        value: caseOutcome.outcomeUuid,
        text: caseOutcome.outcomeName,
        checked: caseOutcome.outcomeUuid === offenceOutcomeForm.offenceOutcome
    } %}
    {{ radiosData.items.push(caseOutcomeRow) }}
{% endfor %}

{% if primaryOutcomes.length and nonCustodialOutcomes.length %}
    {{ radiosData.items.push({ divider: "or" }) }}
{% endif %}

{% for caseOutcome in nonCustodialOutcomes %}
    {% set caseOutcomeRow = {
        value: caseOutcome.outcomeUuid,
        text: caseOutcome.outcomeName,
        checked: caseOutcome.outcomeUuid === offenceOutcomeForm.offenceOutcome
    } %}
    {{ radiosData.items.push(caseOutcomeRow) }}
{% endfor %}

{% block pageContent %}
    <form method="post" action="/person/{{ nomsId }}/{{ addOrEditCourtCase }}/{{ courtCaseReference }}/{{ addOrEditCourtAppearance }}/{{ appearanceReference }}/offences/{{ chargeUuid }}/submit-update-offence-outcome?backTo={{ backTo }}{{'&submitToEditOffence=true' if submitToEditOffence else ''}}{{'&chargeUuids=' + chargeUuids if chargeUuids else ''}}" autocomplete="off">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        {{ govukRadios(radiosData) }}

        <div class="govuk-button-group">
                    {{ govukButton({
                        text: "Continue",
                        attributes: {  'data-qa': 'continue-button' }
                    }) }}
                    {{ cancelToConfirm(nomsId, addOrEditCourtCase, courtCaseReference, addOrEditCourtAppearance, appearanceReference, currentPageUrl) }}
        </div>
    </form>

{% endblock %}
