{% extends "../../partials/backLinkLayout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = applicationName + " - You cannot mark a sentence as active from an inactive court case" %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">You cannot mark a sentence as active from an inactive court case</h1>

            <h2 class="govuk-heading-m">What to do next</h2>
            <p class="govuk-body">You must mark the court case as active before changing the sentences to active.</p>

            {{ govukButton({
                text: "Cancel and go back",
                classes: "govuk-button--secondary",
                href: editHearingLink,
                attributes: { 'data-qa': 'cancel-and-go-back-button' }
            }) }}
        </div>
    </div>
{% endblock %}
